{
  "name": "oidc",
  "version": "1.0.0",
  "description": "Lambda function to handle authentication with One Identity provider.",
  "private": true,
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "npm run type-check && esbuild src/app/index.ts --bundle --platform=node --outdir=dist --minify --sourcemap --external:dtrace-provider && cd dist && zip -r ../function.zip .",
    "test": "npm run type-check && jest --coverage --silent",
    "test-build": "(cd ../../authCommon && npm install) && (cd ../../authCommonTs && npm install) && npm run test && npm run coverage && npm run sonar && npm run build",
    "coverage": "jest --coverage --coverageReporters=lcov",
    "sonar": "node sonarqube-scanner.js -Dsonar.login=${SONAR_TOKEN}",
    "clean": "rm -rf dist function.zip coverage"
  },
  "license": "ISC",
  "dependencies": {
    "aws-xray-sdk-core": "^3.12.0",
    "axios": "^1.16.1",
    "base64url": "^3.0.1",
    "bunyan": "^1.8.15",
    "jsonwebtoken": "^9.0.0",
    "jwk-to-pem": "^2.0.7",
    "pn-auth-common": "file:../authCommon",
    "pn-auth-common-ts": "file:../authCommonTs"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "^3.1026.0",
    "@types/aws-lambda": "^8.10.159",
    "@types/bunyan": "^1.8.11",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jwk-to-pem": "^2.0.3",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.27.1",
    "jest": "^30.2.0",
    "nyc": "^17.1.0",
    "sonarqube-scanner": "^3.0.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  }
}
